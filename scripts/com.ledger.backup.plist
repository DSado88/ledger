<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ledger.backup</string>

    <key>Comment</key>
    <string>Daily WAL-safe backup of the Ledger SQLite database (keeps newest 14).</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__LEDGER_DIR__/scripts/backup-ledger.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/ledger-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ledger-backup.err</string>
</dict>
</plist>
