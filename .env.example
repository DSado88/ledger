# Copy to .env (gitignored). Choose ONE Plaid credential path:

# ── Path A: plain env vars (simplest) ───────────────────────────────────
# PLAID_CLIENT_ID=your_client_id
# PLAID_SECRET=your_secret

# ── Path B: 1Password (no plaintext secrets on disk) ────────────────────
# Leave the two above unset; the app reads creds from 1Password via `op`.
# A service-account token lets it run non-interactively (see README).
# OP_SERVICE_ACCOUNT_TOKEN=ops_...

# Plaid environment: sandbox | production  (start with sandbox)
PLAID_ENV=sandbox

# Optional: override the server port (default 7815) or db file.
# LEDGER_PORT=7815
# LEDGER_DB=ledger.db

# Optional: Amazon/Target reconciliation cookies (else ~/.config/*/cookies.txt
# or your local Chrome cookies are used).
# AMAZON_COOKIES=/path/to/amazon-cookies.txt
# TARGET_COOKIES=/path/to/target-cookies.txt
